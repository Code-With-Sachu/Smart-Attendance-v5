# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/smart_attendance?retryWrites=true&w=majority
# Optional: database name if not in the URI
MONGODB_DB=
# Session signing secret — at least 32 random characters (openssl rand -hex 32)
AUTH_SECRET=
# Public URL used in password-reset links
APP_URL=http://localhost:3000
# Student file upload limit in MB
MAX_UPLOAD_MB=5
# Default WhatsApp country code for numbers entered without one
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
# Optional: password-reset emails via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Smart Attendance <no-reply@yourdomain.com>"
